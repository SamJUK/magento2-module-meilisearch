<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog">
            <group id="search">
                <field id="meilisearch_magento_synonyms" translate="label comment" type="select" sortOrder="210" showInDefault="1" canRestore="1">
                    <label>Use Magento Search Synonyms</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Sends the groups from Marketing > SEO &amp; Search > Search Synonyms to Meilisearch. This replaces any synonyms set on the Indices page, so move those to Magento first. When turned off, the synonyms on the index stay as they are and can be edited on the Indices page.</comment>
                    <depends>
                        <field id="engine">meilisearch</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
